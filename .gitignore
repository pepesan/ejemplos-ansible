.idea
inventory-*

# Generated secrets: random per-host passwords, the Kasm API key, and the
# resulting access CSV. Never commit these, regardless of which playbook_dir
# a role writes them to (31_vault/, roles/examples/, ...).
.credenciales/
datos-acceso-*.csv
.datos-acceso*.lock
kasm-api-key-*.json
__pycache__/
*.pyc

# Plan de trabajo local de los roles (no se versiona)
roles/PLAN.md

# Ficheros de bloqueo, swap, autoguardado y temporales de editores/ofimática:
# aparecen al tener un fichero abierto (p. ej. un CSV de credenciales en
# LibreOffice) y no deben colarse en un commit.
.~lock.*#
~$*
.~*
*.swp
*.swo
.*.swp
*~
.#*
\#*#
*.tmp
.DS_Store

# Estado vivo de cada nodo Kasm del despliegue (fases, notas, historial):
# información operativa local, nunca va al repositorio.
ESTADO-NODOS.md

# Roles y collections de Galaxy instalados localmente (se regeneran con requirements.yml)
.ansible/

# Roles de Galaxy instalados dentro de roles/ (se regeneran con roles/requirements.yml)
roles/geerlingguy.*/
