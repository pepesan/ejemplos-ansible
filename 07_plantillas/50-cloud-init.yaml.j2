# {{ ansible_managed }}
# IP estática generada a partir de los facts del host (interfaz, IP, prefijo y puerta de enlace).
# Para que cloud-init no sobrescriba este fichero en el próximo arranque, el playbook crea
# /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg con: network: {config: disabled}
network:
  version: 2
  ethernets:
    {{ ansible_facts['default_ipv4']['interface'] }}:
      dhcp4: false
      dhcp6: false
      addresses: [{{ ansible_facts['default_ipv4']['address'] }}/{{ ansible_facts['default_ipv4']['prefix'] }}]
      routes:
        - to: default
          via: {{ ansible_facts['default_ipv4']['gateway'] }}
      nameservers:
        addresses: [{{ dns_servers | join(', ') }}]
